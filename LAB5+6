SELECT * FROM Assigned_To;

SELECT e.empno, e.ename, p.pname
FROM Employee e
JOIN Assigned_To a ON e.empno = a.empno
JOIN Project p ON p.pno = a.pno;

SELECT e.ename, SUM(i.incentive_amount) AS total_incentive
FROM Employee e
JOIN Incentives i ON e.empno = i.empno
GROUP BY e.empno, e.ename;

SELECT p.pname, p.ploc
FROM Project p
JOIN Assigned_To a ON p.pno = a.pno
WHERE a.job_role = 'Project Manager';

SELECT d.dname, COUNT(e.empno) AS num_employees
FROM Dept d
JOIN Employee e ON d.deptno = e.deptno
GROUP BY d.dname;

SELECT e.ename
FROM Employee e
LEFT JOIN Assigned_To a ON e.empno = a.empno
WHERE a.pno IS NULL;

SELECT e.ename, d.dname, d.dloc
FROM Employee e
JOIN Dept d ON e.deptno = d.deptno;

SELECT e.empno, e.ename
FROM Employee e
WHERE e.mgr_no = 101;

SELECT p.pname, COUNT(a.empno) AS num_employees
FROM Project p
JOIN Assigned_To a ON p.pno = a.pno
GROUP BY p.pname;

SELECT e1.ename, d.dname, d.dloc
FROM Employee e1
JOIN Dept d ON e1.deptno = d.deptno
WHERE e1.mgr_no IN (
    SELECT e2.mgr_no
    FROM Employee e2
    WHERE e2.empno = 101
);

SELECT e.ename, COUNT(i.incentive_date) AS num_incentives, SUM(i.incentive_amount) AS total_incentive
FROM Employee e
JOIN Incentives i ON e.empno = i.empno
GROUP BY e.empno, e.ename;

SELECT e.empno, e.ename
FROM Employee e
JOIN Assigned_To a ON e.empno = a.empno
WHERE a.job_role LIKE '%Developer%';

SELECT d.dname, AVG(e.sal) AS avg_salary
FROM Dept d
JOIN Employee e ON d.deptno = e.deptno
GROUP BY d.dname;





