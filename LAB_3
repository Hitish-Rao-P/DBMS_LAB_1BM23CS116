SELECT customer_name
FROM bank_account b, depositer d
WHERE b.acc_no = d.acc_no
GROUP BY d.customer_name, branch_name
HAVING COUNT(b.acc_no) > 1;

CREATE VIEW branch_loan_summary AS
SELECT branch_name, SUM(loan_amount) AS total_loans
FROM loan
GROUP BY branch_name;

